---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Notes | MorphJS">
  <h1>Notes</h1>
  {posts.length === 0 ? (
    <p class="meta">Nothing published yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
          <div class="meta">
            {post.data.date.toISOString().slice(0, 10)} · {post.data.platform}
            {post.data.difficulty && ` · ${post.data.difficulty}`}
          </div>
          <div>
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </li>
      ))}
    </ul>
  )}
</Base>
